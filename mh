#!/bin/bash
# mh — the write path for agents.
#
# Two ways to call it, both supported:
#   ./operations/mh task done aba-academy#25     from the repo, no install
#   mh task done aba-academy#25                  anywhere, if symlinked onto PATH
#
# The repo is found the way git finds one: walk up from the working directory
# looking for operations/tasks.db. That makes both forms work from any
# subdirectory, and means a symlink on PATH does not have to guess.
set -euo pipefail

# Only two ways to decide which repo this acts on: an explicit
# MELLONHEAD_ROOT, or a store found by walking up from the working directory.
#
# There is deliberately no fallback to the script's own location. When this is
# a symlink on PATH, that fallback made `mh` standing in a repo with no store
# silently operate on whichever repo the symlink happened to live in, and
# report its rows as though they were this one's. Wrong target, no warning.
find_repo() {
    [ -n "${MELLONHEAD_ROOT:-}" ] && { echo "$MELLONHEAD_ROOT"; return; }
    local dir="$PWD"
    while [ "$dir" != "/" ]; do
        [ -f "$dir/operations/tasks.db" ] && { echo "$dir"; return; }
        dir="$(dirname "$dir")"
    done
    echo ""
}

REPO="$(find_repo)"
if [ -n "$REPO" ]; then
    export MELLONHEAD_ROOT="$REPO"
elif [[ " $* " != *" --repo "* ]]; then
    echo "mh: no task store found." >&2
    echo "Looked for operations/tasks.db from $PWD upwards." >&2
    echo "Set MELLONHEAD_ROOT, pass --repo, or run from inside the repo." >&2
    exit 2
fi

# Self-contained on purpose: this file is copied into the content repo, so it
# cannot source anything from the checkout it is looking for.
PYTHON=""
for py in "${CSM_PYTHON:-}" /opt/homebrew/bin/python3 /usr/local/bin/python3 \
          "$(command -v python3 2>/dev/null)"; do
    [ -n "$py" ] && [ -x "$py" ] || continue
    "$py" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null \
        && { PYTHON="$py"; break; }
done
if [ -z "$PYTHON" ]; then
    echo "mh: needs Python 3.11 or newer. Install one (brew install python)" >&2
    echo "    or point \$CSM_PYTHON at it." >&2
    exit 127
fi

# install-mh.sh writes the checkout it was run from into the line below, so a
# clone anywhere works without MH_CODE. In the checkout itself it stays a
# placeholder and the fallbacks apply.
INSTALLED_FROM="@MH_CODE@"

for candidate in \
    "${MH_CODE:-}" \
    "$INSTALLED_FROM" \
    "$HOME/Projects/claude-sessions"
do
    [ -n "$candidate" ] && [ -f "$candidate/mhcli.py" ] && {
        exec "$PYTHON" "$candidate/mhcli.py" "$@"
    }
done

echo "mh: cannot find mhcli.py. Set \$MH_CODE to the session-manager checkout." >&2
exit 127
